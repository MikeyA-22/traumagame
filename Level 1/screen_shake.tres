code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D screen_tex_frg_9 : hint_screen_texture;



void fragment() {
// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_in4p2 = vec2(0.00000, 0.00000);
	vec2 n_out4p0 = n_in4p2 * n_in4p1 + UV;


// VectorDecompose:11
	float n_out11p0 = n_out4p0.x;
	float n_out11p1 = n_out4p0.y;


// Input:8
	float n_out8p0 = TIME;


// FloatConstant:3
	float n_out3p0 = 0.000000;


// FloatOp:5
